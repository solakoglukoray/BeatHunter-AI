# === Python System Files ===
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.tldp_cache/

# === Data & Datasets ===
# We exclude these to keep the repository lightweight and avoid GitHub size limits
dataset/
dataset_v2/
dataset_processed/

# === Inference & Temporary Files ===
# Files generated during Demucs separation or temporary analysis
temp_inference/
htdemucs/
*.mp3
*.wav
*.png
*.jpg
*.jpeg

# === Machine Learning Models ===
# Large binary files should not be tracked in Git (use LFS if needed)
models/*.keras
models/*.npy
models/*.h5
# We keep classes.json as it defines the label taxonomy
!models/classes.json

# === Environments & IDEs ===
.env
.venv
venv/
env/
.vscode/
.idea/

# === OS Specific Files ===
.DS_Store
Thumbs.db

# === Database & Security Files ===
*.db
*.sqlite3
beathunter_users.db

# FAISS
models/*.index
*.index
# Training checkpoint state (transient, regenerated every run)
models/training_checkpoint.keras
models/training_state.json
models/subset_*.keras
models/subset_*.json
# Mood signal cache — derived from the audio, ~4 min to rebuild with calibrate_mood.py.
# The calibration it produces IS tracked: without it audio_features silently returns no
# mood at all, so it is a runtime dependency, not a build artefact.
models/mood_signals.npz

# Classical-feature extraction cache (regenerable: train_classic.py --extract, ~14 min)
models/classic_features.npz

# PANNs experiment weights (downloaded, ~327 MB)
panns_data/
models/panns_*.npz

# PANNs fine-tune artefaktlari (buyuk, yeniden uretilebilir)
models/panns_finetune_*.pt
models/panns_ft_encoder.pt
models/panns_ft_features.npz
models/panns_finetune_state.json
